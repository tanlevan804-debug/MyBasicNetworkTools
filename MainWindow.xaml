<Window x:Class="MyBasicNetworkTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Basic Network Tools"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F5F9">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="#1E293B">

            <StackPanel>

                <TextBlock Text="MY BASIC"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="20,30,20,0"/>

                <TextBlock Text="NETWORK TOOLS"
                           Foreground="#94A3B8"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="20,0,20,40"/>

                <Button Content="Dashboard"
                        Height="45"
                        Margin="10,5"
                        Click="Dashboard_Click"/>

                <Button Content="My Ping"
                        Height="45"
                        Margin="10,5"
                        Click="Ping_Click"/>

                <Button Content="My Tracert"
                        Height="45"
                        Margin="10,5"
                        Click="Tracert_Click"/>

                <Button Content="DNS Query"
                        Height="45"
                        Margin="10,5"
                        Click="Dns_Click"/>

                <Button Content="Scan IP"
                        Height="45"
                        Margin="10,5"
                        Click="Scan_Click"/>

                <Button Content="Network Information"
                        Height="45"
                        Margin="10,5"
                        Click="Network_Click"/>

            </StackPanel>

        </Border>


        <!-- ================= MAIN ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border Grid.Row="0"
                    Background="White">

                <TextBlock Text="Network Diagnostic Dashboard"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="25,0"/>

            </Border>


            <!-- CONTENT -->

            <ScrollViewer Grid.Row="1">

                <StackPanel Margin="30">

                    <TextBlock Text="Welcome to My Basic Network Tools"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="Windows network diagnostic and analysis toolkit"
                               FontSize="15"
                               Foreground="#64748B"
                               Margin="0,5,0,25"/>


                    <!-- NETWORK STATUS -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- INTERNET -->

                        <Border Grid.Column="0"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Internet Status"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="InternetStatus"
                                           Text="Online"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- LOCAL IP -->

                        <Border Grid.Column="1"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Local IP"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="LocalIpText"
                                           Text="Loading..."
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- GATEWAY -->

                        <Border Grid.Column="2"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Default Gateway"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="GatewayText"
                                           Text="Loading..."
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- TOOLS -->

                    <TextBlock Text="Network Tools"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="5,30,5,15"/>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>


                        <!-- PING -->

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="My Ping"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Check connectivity and response time."
                                           Foreground="#64748B"
                                           Margin="0,10"/>

                                <Button Content="Open Ping"
                                        Width="110"
                                        HorizontalAlignment="Left"
                                        Click="Ping_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- TRACERT -->

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="My Tracert"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Analyze the route to a destination."
                                           Foreground="#64748B"
                                           Margin="0,10"/>

                                <Button Content="Open Tracert"
                                        Width="110"
                                        HorizontalAlignment="Left"
                                        Click="Tracert_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- DNS -->

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="DNS Query"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Query DNS records of a domain."
                                           Foreground="#64748B"
                                           Margin="0,10"/>

                                <Button Content="Open DNS"
                                        Width="110"
                                        HorizontalAlignment="Left"
                                        Click="Dns_Click"/>

                            </StackPanel>

                        </Border>


                        <!-- SCAN -->

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Background="White"
                                Margin="5"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Scan IP"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Scan active hosts in an IP range."
                                           Foreground="#64748B"
                                           Margin="0,10"/>

                                <Button Content="Open Scanner"
                                        Width="110"
                                        HorizontalAlignment="Left"
                                        Click="Scan_Click"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>