<Window x:Class="MyBasicNetworkTools.Views.NetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Information"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F5F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="White">

            <TextBlock Text="🌐 Network Information"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="25,0"/>

        </Border>

        <!-- CONTENT -->

        <StackPanel Grid.Row="1"
                    Margin="25">

            <TextBlock Text="Network Adapters"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <DataGrid x:Name="NetworkGrid"
                      AutoGenerateColumns="False"
                      Height="430"
                      Background="White"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserSortColumns="True"
                      Sorting="NetworkGrid_Sorting">

                <DataGrid.Columns>

                    <!-- Adapter -->

                    <DataGridTextColumn
                        Header="Adapter"
                        Binding="{Binding AdapterName}"
                        SortMemberPath="AdapterName"
                        Width="220"/>

                    <!-- Status -->

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"
                        SortMemberPath="Status"
                        Width="90"/>

                    <!-- IPv4 -->

                    <DataGridTextColumn
                        Header="IPv4"
                        Binding="{Binding IPv4}"
                        SortMemberPath="IPv4"
                        Width="140"/>

                    <!-- Subnet Mask -->

                    <DataGridTextColumn
                        Header="Subnet Mask"
                        Binding="{Binding SubnetMask}"
                        SortMemberPath="SubnetMask"
                        Width="140"/>

                    <!-- Gateway -->

                    <DataGridTextColumn
                        Header="Gateway"
                        Binding="{Binding Gateway}"
                        SortMemberPath="Gateway"
                        Width="140"/>

                    <!-- DNS -->

                    <DataGridTextColumn
                        Header="DNS"
                        Binding="{Binding DNS}"
                        SortMemberPath="DNS"
                        Width="180"/>

                    <!-- MAC -->

                    <DataGridTextColumn
                        Header="MAC"
                        Binding="{Binding MAC}"
                        SortMemberPath="MAC"
                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- REFRESH BUTTON -->

            <Button x:Name="RefreshButton"
                    Content="REFRESH"
                    Width="120"
                    Height="40"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0"
                    FontWeight="Bold"
                    Click="RefreshButton_Click"/>

        </StackPanel>

    </Grid>

</Window>