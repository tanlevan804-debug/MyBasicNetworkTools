<Window x:Class="MyBasicNetworkTools.Views.DnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My DNS Query"
        Height="850"
        Width="1300"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F5F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="White">

            <TextBlock Text="🔎 My DNS Query"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="30,0"/>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="25">

            <Grid.RowDefinitions>

                <!-- INPUT -->
                <RowDefinition Height="Auto"/>

                <!-- DNS HEADER -->
                <RowDefinition Height="Auto"/>

                <!-- RECORD TABLE -->
                <RowDefinition Height="*"/>

                <!-- INFORMATION -->
                <RowDefinition Height="Auto"/>

                <!-- RAW PACKET -->
                <RowDefinition Height="150"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- INPUT PANEL -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="145"/>

                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="120"/>

                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>

                    </Grid.ColumnDefinitions>


                    <!-- DOMAIN -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Domain:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="DomainTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Height="32"
                             Margin="5"
                             Text="google.com"/>


                    <!-- DNS SERVER -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="DNS Server:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <ComboBox x:Name="DnsServerComboBox"
                              Grid.Row="0"
                              Grid.Column="3"
                              Height="32"
                              Margin="5"
                              SelectedIndex="0">

                        <ComboBoxItem Content="8.8.8.8"/>
                        <ComboBoxItem Content="1.1.1.1"/>
                        <ComboBoxItem Content="9.9.9.9"/>

                    </ComboBox>


                    <!-- RECORD TYPE -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Text="Record:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <ComboBox x:Name="RecordTypeComboBox"
                              Grid.Row="0"
                              Grid.Column="5"
                              Height="32"
                              Margin="5"
                              SelectedIndex="0">

                        <ComboBoxItem Content="A"/>
                        <ComboBoxItem Content="AAAA"/>
                        <ComboBoxItem Content="CNAME"/>
                        <ComboBoxItem Content="MX"/>
                        <ComboBoxItem Content="NS"/>
                        <ComboBoxItem Content="TXT"/>
                        <ComboBoxItem Content="PTR"/>
                        <ComboBoxItem Content="ANY"/>
                        <ComboBoxItem Content="SOA"/>
                        <ComboBoxItem Content="SRV"/>

                    </ComboBox>


                    <!-- PORT -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="6"
                               Text="Port:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <TextBox x:Name="PortTextBox"
                             Grid.Row="0"
                             Grid.Column="7"
                             Height="32"
                             Margin="5"
                             Text="53"/>


                    <!-- TIMEOUT -->

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Timeout:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="TimeoutTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="32"
                             Margin="5"
                             Text="5000"/>


                    <!-- QUERY -->

                    <Button x:Name="QueryButton"
                            Grid.Row="1"
                            Grid.Column="2"
                            Content="QUERY"
                            Height="32"
                            Margin="5"
                            FontWeight="Bold"
                            Click="QueryButton_Click"/>


                    <!-- STOP -->

                    <Button x:Name="StopButton"
                            Grid.Row="1"
                            Grid.Column="3"
                            Content="STOP"
                            Height="32"
                            Margin="5"
                            FontWeight="Bold"
                            IsEnabled="False"
                            Click="StopButton_Click"/>


                    <!-- CLEAR -->

                    <Button x:Name="ClearButton"
                            Grid.Row="1"
                            Grid.Column="4"
                            Grid.ColumnSpan="2"
                            Content="CLEAR"
                            Height="32"
                            Margin="5"
                            FontWeight="Bold"
                            Click="ClearButton_Click"/>


                    <!-- COPY -->

                    <Button x:Name="CopyButton"
                            Grid.Row="1"
                            Grid.Column="6"
                            Grid.ColumnSpan="2"
                            Content="COPY"
                            Height="32"
                            Margin="5"
                            FontWeight="Bold"
                            Click="CopyButton_Click"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- DNS HEADER -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ROW 1 -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="DNS HEADER"
                               FontSize="16"
                               FontWeight="Bold"/>


                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="Transaction ID:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TransactionIdText"
                               Grid.Row="0"
                               Grid.Column="2"/>


                    <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               Text="Opcode:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="OpcodeText"
                               Grid.Row="0"
                               Grid.Column="4"/>


                    <TextBlock Grid.Row="0"
                               Grid.Column="5"
                               Text="RCODE:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="RcodeText"
                               Grid.Row="0"
                               Grid.Column="6"/>


                    <!-- ROW 2 -->

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Flags:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="FlagsText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"/>


                    <TextBlock Grid.Row="1"
                               Grid.Column="4"
                               Text="Q/A/NS/AR:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="CountsText"
                               Grid.Row="1"
                               Grid.Column="5"
                               Grid.ColumnSpan="2"/>


                    <!-- ROW 3 : EDNS -->

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="EDNS:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="EdnsText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Grid.ColumnSpan="6"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- RECORD TABLE -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="15">

                <DataGrid x:Name="ResultGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">

                    <DataGrid.Columns>

                        <!-- RECORD TYPE -->

                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding RecordType}"
                                            Width="80"/>


                        <!-- TYPE CODE -->

                        <DataGridTextColumn Header="Type Code"
                                            Binding="{Binding RecordTypeCode}"
                                            Width="90"/>


                        <!-- NAME -->

                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="220"/>


                        <!-- DATA -->

                        <DataGridTextColumn Header="Data / Value"
                                            Binding="{Binding Value}"
                                            Width="*"/>


                        <!-- TTL -->

                        <DataGridTextColumn Header="TTL"
                                            Binding="{Binding TTL}"
                                            Width="90"/>


                        <!-- CLASS -->

                        <DataGridTextColumn Header="Class"
                                            Binding="{Binding Class}"
                                            Width="80"/>


                        <!-- SECTION -->

                        <DataGridTextColumn Header="Section"
                                            Binding="{Binding Section}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- ================================================= -->
            <!-- INFORMATION -->
            <!-- ================================================= -->

            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,12">

                <WrapPanel>

                    <!-- STATUS -->

                    <TextBlock Text="Status:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="StatusText"
                               Margin="5,0,25,0"/>


                    <!-- DNS SERVER -->

                    <TextBlock Text="DNS Server:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DnsServerUsedText"
                               Margin="5,0,25,0"/>


                    <!-- PROTOCOL -->

                    <TextBlock Text="Protocol:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="ProtocolText"
                               Margin="5,0,25,0"/>


                    <!-- UDP TIME -->

                    <TextBlock Text="UDP:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="UdpQueryTimeText"
                               Margin="5,0,20,0"/>


                    <!-- TCP TIME -->

                    <TextBlock Text="TCP:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TcpQueryTimeText"
                               Margin="5,0,20,0"/>


                    <!-- TOTAL TIME -->

                    <TextBlock Text="Total:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TotalQueryTimeText"
                               Margin="5,0,20,0"/>


                    <!-- AA -->

                    <TextBlock Text="AA:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="AaText"
                               Margin="5,0,20,0"/>


                    <!-- TC -->

                    <TextBlock Text="TC:"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TcText"
                               Margin="5,0,20,0"/>

                </WrapPanel>

            </Border>


            <!-- ================================================= -->
            <!-- RAW PACKET -->
            <!-- ================================================= -->

            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="8"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- RAW HEADER -->

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Raw DNS Response (HEX)"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>


                        <Button Content="EXPORT TXT"
                                Width="100"
                                Height="25"
                                Margin="25,0,5,0"
                                Click="ExportTxtButton_Click"/>


                        <Button Content="EXPORT CSV"
                                Width="100"
                                Height="25"
                                Click="ExportCsvButton_Click"/>

                    </StackPanel>


                    <!-- RAW DATA -->

                    <TextBox x:Name="RawPacketTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>