<Window x:Class="MyBasicNetworkTools.Views.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Scan IP"
        Height="700"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F5F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White">

            <TextBlock Text="🖥 My Scan IP"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="25,0"/>

        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PREFIX -->
            <TextBlock Grid.Row="0"
                       Text="Network Prefix"
                       FontSize="16"
                       FontWeight="Bold"/>

            <Grid Grid.Row="1"
                  Margin="0,8,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PrefixTextBox"
                         Grid.Column="0"
                         Text="192.168.1"
                         Height="40"
                         FontSize="16"
                         Padding="10,2"
                         VerticalContentAlignment="Center"/>

                <Button x:Name="ScanButton"
                        Grid.Column="1"
                        Content="SCAN"
                        Height="40"
                        Margin="10,0,0,0"
                        FontWeight="Bold"
                        Click="ScanButton_Click"/>

                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Content="STOP"
                        Height="40"
                        Margin="10,0,0,0"
                        FontWeight="Bold"
                        IsEnabled="False"
                        Click="StopButton_Click"/>

            </Grid>

            <!-- PROGRESS -->
            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Row="0"
                             Height="15"
                             Minimum="0"
                             Maximum="254"
                             Value="0"
                             Margin="0,0,0,15"/>

                <DataGrid x:Name="ResultGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="White">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="IP Address"
                            Binding="{Binding IP}"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="Status"
                            Binding="{Binding Status}"
                            Width="150"/>

                        <DataGridTextColumn
                            Header="Response Time"
                            Binding="{Binding ResponseTime}"
                            Width="180"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <!-- STATISTICS -->
            <Border Grid.Row="3"
                    Background="White"
                    Margin="0,15,0,0"
                    Padding="15">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Total: "
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TotalText"
                               Text="0"
                               Margin="5,0,25,0"/>

                    <TextBlock Text="Online: "
                               FontWeight="Bold"/>

                    <TextBlock x:Name="OnlineText"
                               Text="0"
                               Margin="5,0,25,0"/>

                    <TextBlock Text="Offline: "
                               FontWeight="Bold"/>

                    <TextBlock x:Name="OfflineText"
                               Text="0"
                               Margin="5,0,25,0"/>

                    <TextBlock x:Name="ProgressText"
                               Text="Ready"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>