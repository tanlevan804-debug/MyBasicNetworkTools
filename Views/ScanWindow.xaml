<Window x:Class="MyBasicNetworkTools.Views.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Scan IP"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="ColumnHeaderHeight" Value="29"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D8DEE8"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="🖥"
                               FontSize="27"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="My Scan IP"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="IP / Subnet Scanner"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- CONFIGURATION -->
        <GroupBox Grid.Row="1"
                  Header="Scan Configuration"
                  Background="White">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Target mode -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Target:"
                           VerticalAlignment="Center"
                           Margin="4"/>

                <ComboBox x:Name="TargetComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          SelectedIndex="0">
                    <ComboBoxItem Content="CIDR"/>
                    <ComboBoxItem Content="IP Range"/>
                </ComboBox>

                <Button Grid.Row="0"
                        Grid.Column="4"
                        Content="MY IP / SUBNET"
                        Click="MySubnetButton_Click"
                        MinWidth="125"/>

                <!-- Start IP -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Start IP / CIDR:"
                           VerticalAlignment="Center"
                           Margin="4"/>

                <TextBox x:Name="StartIpTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Text="192.168.1.0/24"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="End IP:"
                           VerticalAlignment="Center"
                           Margin="8,4,4,4"/>

                <TextBox x:Name="EndIpTextBox"
                         Grid.Row="1"
                         Grid.Column="3"/>

                <!-- Scan mode -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Scan Mode:"
                           VerticalAlignment="Center"
                           Margin="4"/>

                <ComboBox x:Name="ScanModeComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Quick Ping"/>
                    <ComboBoxItem Content="Full Scan (Ping + Ports)"/>
                </ComboBox>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Timeout (ms):"
                           VerticalAlignment="Center"
                           Margin="8,4,4,4"/>

                <TextBox x:Name="TimeoutTextBox"
                         Grid.Row="2"
                         Grid.Column="3"
                         Text="1000"/>

                <!-- Concurrency -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Concurrency:"
                           VerticalAlignment="Center"
                           Margin="4"/>

                <TextBox x:Name="ConcurrencyTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Text="50"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="Ports:"
                           VerticalAlignment="Center"
                           Margin="8,4,4,4"/>

                <TextBox x:Name="PortsTextBox"
                         Grid.Row="3"
                         Grid.Column="3"
                         Text="21,22,23,25,53,80,135,139,443,445,3389"/>

            </Grid>
        </GroupBox>

        <!-- RESULTS -->
        <GroupBox Grid.Row="2"
                  Header="Scan Results"
                  Background="White"
                  MinHeight="180">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Progress -->
                <Grid Grid.Row="0"
                      Margin="2,0,2,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ProgressBar"
                                 Grid.Column="0"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="18"
                                 VerticalAlignment="Center"
                                 Foreground="#16A34A"
                                 Background="#E5E7EB"/>

                    <TextBlock x:Name="ProgressText"
                               Grid.Column="1"
                               Text="0 / 0 (0%)"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,4,0"/>
                </Grid>

                <!-- Result table -->
                <DataGrid x:Name="ResultGrid"
                          Grid.Row="1"
                          MinHeight="100">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP Address"
                                            Binding="{Binding IPAddress}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="85"/>

                        <DataGridTextColumn Header="Hostname"
                                            Binding="{Binding Hostname}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="RTT (ms)"
                                            Binding="{Binding RTT}"
                                            Width="85"/>

                        <DataGridTextColumn Header="MAC Address"
                                            Binding="{Binding MACAddress}"
                                            Width="145"/>

                        <DataGridTextColumn Header="Open Ports"
                                            Binding="{Binding OpenPorts}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- ACTIONS -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Ready"
                           VerticalAlignment="Center"
                           Margin="6"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="ScanButton"
                            Content="SCAN"
                            Click="ScanButton_Click"
                            MinWidth="90"/>

                    <Button x:Name="StopButton"
                            Content="STOP"
                            Click="StopButton_Click"
                            IsEnabled="False"
                            MinWidth="80"/>

                    <Button Content="COPY"
                            Click="CopyButton_Click"
                            MinWidth="80"/>

                    <Button Content="CLEAR"
                            Click="ClearButton_Click"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATISTICS -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SCANNED"
                               Foreground="#64748B"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScannedText"
                               Text="0"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="ALIVE"
                               Foreground="#16A34A"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="AliveText"
                               Text="0"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="DEAD"
                               Foreground="#64748B"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DeadText"
                               Text="0"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="OPEN PORTS"
                               Foreground="#64748B"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="OpenPortsText"
                               Text="0"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="SCAN TIME"
                               Foreground="#64748B"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScanTimeText"
                               Text="0 ms"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <Button Grid.Column="5"
                        Content="EXPORT CSV"
                        Click="ExportCsvButton_Click"
                        MinWidth="100"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>