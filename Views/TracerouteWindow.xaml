<Window x:Class="MyBasicNetworkTools.Views.TracerouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyBasicNetworkTools.Views"
        Title="My Tracert"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ============================================== -->
        <!-- RTT CONVERTER -->
        <!-- ============================================== -->

        <local:RttConverter x:Key="RttConverter"/>

        <!-- ============================================== -->
        <!-- DATAGRID ROW STYLE -->
        <!-- ============================================== -->

        <Style x:Key="TraceRowStyle"
               TargetType="DataGridRow">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Height"
                    Value="34"/>

            <Style.Triggers>

                <!-- TTL EXPIRED -->
                <DataTrigger Binding="{Binding Status}"
                             Value="TTL Expired">

                    <Setter Property="Background"
                            Value="#EFF6FF"/>

                    <Setter Property="Foreground"
                            Value="#1D4ED8"/>

                </DataTrigger>

                <!-- SUCCESS -->
                <DataTrigger Binding="{Binding Status}"
                             Value="Success">

                    <Setter Property="Background"
                            Value="#F0FDF4"/>

                    <Setter Property="Foreground"
                            Value="#15803D"/>

                </DataTrigger>

                <!-- DESTINATION REACHED -->
                <DataTrigger Binding="{Binding Status}"
                             Value="Destination Reached">

                    <Setter Property="Background"
                            Value="#DCFCE7"/>

                    <Setter Property="Foreground"
                            Value="#166534"/>

                    <Setter Property="FontWeight"
                            Value="Bold"/>

                </DataTrigger>

                <!-- TIMED OUT -->
                <DataTrigger Binding="{Binding Status}"
                             Value="Timed Out">

                    <Setter Property="Background"
                            Value="#FEF2F2"/>

                    <Setter Property="Foreground"
                            Value="#B91C1C"/>

                </DataTrigger>

                <!-- NETWORK UNREACHABLE -->
                <DataTrigger Binding="{Binding Status}"
                             Value="Network Unreachable">

                    <Setter Property="Background"
                            Value="#FFF7ED"/>

                    <Setter Property="Foreground"
                            Value="#C2410C"/>

                    <Setter Property="FontWeight"
                            Value="Bold"/>

                </DataTrigger>

                <!-- HOST UNREACHABLE -->
                <DataTrigger Binding="{Binding Status}"
                             Value="Host Unreachable">

                    <Setter Property="Background"
                            Value="#FFF7ED"/>

                    <Setter Property="Foreground"
                            Value="#C2410C"/>

                    <Setter Property="FontWeight"
                            Value="Bold"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ================================================== -->
    <!-- MAIN -->
    <!-- ================================================== -->

    <Grid Background="#F1F5F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================================================== -->
        <!-- HEADER -->
        <!-- ================================================== -->

        <Border Grid.Row="0"
                Background="White">

            <Grid>

                <TextBlock Text="🌐 My Tracert"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="25,0"/>

            </Grid>

        </Border>


        <!-- ================================================== -->
        <!-- CONTENT -->
        <!-- ================================================== -->

        <Grid Grid.Row="1"
              Margin="25">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================== -->
            <!-- TARGET -->
            <!-- ================================================== -->

            <TextBlock Grid.Row="0"
                       Text="Target Host"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>


            <Grid Grid.Row="1"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="110"/>

                    <ColumnDefinition Width="110"/>

                    <ColumnDefinition Width="110"/>

                </Grid.ColumnDefinitions>


                <!-- TARGET -->

                <TextBox x:Name="TargetTextBox"
                         Grid.Column="0"
                         Height="40"
                         FontSize="16"
                         Padding="10,2"
                         VerticalContentAlignment="Center"
                         Text="google.com"/>


                <!-- START -->

                <Button x:Name="StartButton"
                        Grid.Column="1"
                        Content="START"
                        Height="40"
                        Margin="10,0,0,0"
                        FontWeight="Bold"
                        Click="StartButton_Click"/>


                <!-- STOP -->

                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Content="STOP"
                        Height="40"
                        Margin="10,0,0,0"
                        FontWeight="Bold"
                        IsEnabled="False"
                        Click="StopButton_Click"/>


                <!-- CLEAR -->

                <Button x:Name="ClearButton"
                        Grid.Column="3"
                        Content="CLEAR"
                        Height="40"
                        Margin="10,0,0,0"
                        FontWeight="Bold"
                        Click="ClearButton_Click"/>

            </Grid>


            <!-- ================================================== -->
            <!-- OPTIONS -->
            <!-- ================================================== -->

            <Grid Grid.Row="2"
                  Margin="0,0,0,20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="200"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- MAX HOPS -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Max Hops"
                               FontWeight="Bold"/>

                    <TextBox x:Name="MaxHopsTextBox"
                             Text="30"
                             Height="35"
                             Margin="0,5,15,0"
                             Padding="8,2"
                             VerticalContentAlignment="Center"/>

                </StackPanel>


                <!-- TIMEOUT -->

                <StackPanel Grid.Column="1">

                    <TextBlock Text="Timeout (ms)"
                               FontWeight="Bold"/>

                    <TextBox x:Name="TimeoutTextBox"
                             Text="3000"
                             Height="35"
                             Margin="0,5,15,0"
                             Padding="8,2"
                             VerticalContentAlignment="Center"/>

                </StackPanel>


                <!-- PROBES -->

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Probes per Hop"
                               FontWeight="Bold"/>

                    <ComboBox x:Name="ProbesComboBox"
                              Height="35"
                              Margin="0,5,15,0"
                              SelectedIndex="2">

                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>

                    </ComboBox>

                </StackPanel>


                <!-- REVERSE DNS -->

                <CheckBox x:Name="ResolveHostnamesCheckBox"
                          Grid.Column="3"
                          Content="Resolve Hostnames (Reverse DNS)"
                          FontWeight="Bold"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,8"
                          IsChecked="False"/>

            </Grid>


            <!-- ================================================== -->
            <!-- RESULT TITLE -->
            <!-- ================================================== -->

            <TextBlock Grid.Row="3"
                       Text="Trace Result"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"
                       VerticalAlignment="Top"/>


            <!-- ================================================== -->
            <!-- RESULT TABLE -->
            <!-- ================================================== -->

            <Border Grid.Row="3"
                    Margin="0,35,0,0"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">

                <DataGrid x:Name="ResultGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          FontSize="13"
                          RowHeight="34"
                          RowStyle="{StaticResource TraceRowStyle}">

                    <DataGrid.Columns>


                        <!-- HOP -->

                        <DataGridTextColumn Header="Hop #"
                                            Binding="{Binding Hop}"
                                            Width="65"/>


                        <!-- RTT 1 -->

                        <DataGridTemplateColumn Header="RTT 1"
                                                Width="95">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding RTT1,
                                        Converter={StaticResource RttConverter}}"
                                        VerticalAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- RTT 2 -->

                        <DataGridTemplateColumn Header="RTT 2"
                                                Width="95">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding RTT2,
                                        Converter={StaticResource RttConverter}}"
                                        VerticalAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- RTT 3 -->

                        <DataGridTemplateColumn Header="RTT 3"
                                                Width="95">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding RTT3,
                                        Converter={StaticResource RttConverter}}"
                                        VerticalAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- AVERAGE -->

                        <DataGridTemplateColumn Header="RTT Average"
                                                Width="110">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Text="{Binding AverageRTT,
                                        Converter={StaticResource RttConverter}}"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- IP -->

                        <DataGridTextColumn Header="IP Address"
                                            Binding="{Binding IPAddress}"
                                            Width="155"/>


                        <!-- HOSTNAME -->

                        <DataGridTextColumn Header="Hostname"
                                            Binding="{Binding Hostname}"
                                            Width="240"/>


                        <!-- STATUS -->

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="200"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- ================================================== -->
            <!-- BOTTOM BAR -->
            <!-- ================================================== -->

            <Border Grid.Row="4"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Margin="0,15,0,0"
                    Padding="10">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="120"/>

                        <ColumnDefinition Width="120"/>

                        <ColumnDefinition Width="120"/>

                    </Grid.ColumnDefinitions>


                    <!-- STATUS -->

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Ready"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>


                    <!-- COPY -->

                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Content="COPY"
                            Height="35"
                            Margin="5,0"
                            FontWeight="Bold"
                            Click="CopyButton_Click"/>


                    <!-- TXT -->

                    <Button x:Name="ExportTxtButton"
                            Grid.Column="2"
                            Content="EXPORT TXT"
                            Height="35"
                            Margin="5,0"
                            FontWeight="Bold"
                            Click="ExportTxtButton_Click"/>


                    <!-- CSV -->

                    <Button x:Name="ExportCsvButton"
                            Grid.Column="3"
                            Content="EXPORT CSV"
                            Height="35"
                            Margin="5,0"
                            FontWeight="Bold"
                            Click="ExportCsvButton_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>